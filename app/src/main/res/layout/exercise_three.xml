<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginBottom="7dp" android:background="@drawable/exercise_card" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal">
 <ImageView android:id="@+id/icon3" android:layout_width="112dp" android:layout_height="86dp" android:scaleType="fitCenter" android:contentDescription="Схема выполнения упражнения" android:src="@drawable/exercise_pose_2"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="8dp" android:orientation="vertical">
  <TextView android:id="@+id/name3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
  <TextView android:id="@+id/reps3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#A9A9AC" android:textSize="11sp"/>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
   <TextView android:id="@+id/minus3" android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:background="@drawable/small_button" android:text="−" android:textColor="#F4F4F4" android:textSize="18sp"/>
   <TextView android:id="@+id/weight3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="62dp" android:gravity="center" android:textColor="#F4F4F4" android:textSize="12sp" android:textStyle="bold"/>
   <TextView android:id="@+id/plus3" android:layout_width="26dp" android:layout_height="26dp" android:gravity="center" android:background="@drawable/small_button" android:text="+" android:textColor="#F4F4F4" android:textSize="18sp"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/check3" android:layout_width="86dp" android:layout_height="48dp" android:gravity="center" android:text="Отметить" android:textColor="#E4E4E4" android:textSize="12sp" android:textStyle="bold" android:contentDescription="Отметить выполнение упражнения"/>
</LinearLayout>